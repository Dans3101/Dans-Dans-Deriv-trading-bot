/**
 * GOLD/USD Strategy (Deriv Commodities)
 * - Runs 24/7 (no session blocking)
 * - Filters low volatility
 * - Trades momentum continuation
 * - Designed to hit $1+ profit fast
 */

function candleBody(c) {
  return Math.abs(Number(c.close) - Number(c.open));
}

function candleMove(c) {
  return Number(c.close) - Number(c.open);
}

export function decideGoldTrade(candles) {
  if (!Array.isArray(candles) || candles.length < 6) return null;

  const recent = candles.slice(-6);

  const bodies = recent.map(candleBody);
  const moves = recent.map(candleMove);

  if (bodies.some(isNaN) || moves.some(isNaN)) return null;

  /* ================= VOLATILITY FILTER ================= */

  const avgBody =
    bodies.reduce((a, b) => a + b, 0) / bodies.length;

  // Gold-specific minimum movement
  if (avgBody < 0.15) {
    // market too flat → skip
    return null;
  }

  /* ================= TREND DIRECTION ================= */

  const upMoves = moves.filter(m => m > 0).length;
  const downMoves = moves.filter(m => m < 0).length;

  /* ================= LAST CANDLE CONFIRMATION ================= */

  const lastMove = moves[moves.length - 1];
  const lastBody = bodies[bodies.length - 1];

  // Weak last candle → skip
  if (lastBody < avgBody * 0.6) return null;

  /* ================= TRADE LOGIC ================= */

  // Strong bullish continuation
  if (upMoves >= 4 && lastMove > 0) {
    return 'CALL';
  }

  // Strong bearish continuation
  if (downMoves >= 4 && lastMove < 0) {
    return 'PUT';
  }

  return null;
}